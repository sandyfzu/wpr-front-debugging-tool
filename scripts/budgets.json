[
  {
    "surface": "background service worker",
    "globs": ["background.js"],
    "maxKb": { "raw": 27 }
  },
  {
    "surface": "known-conflicts DB seed asset (background-owned)",
    "globs": ["assets/background.json"],
    "maxKb": { "raw": 85 }
  },
  {
    "surface": "popup JS",
    "globs": ["chunks/popup-*.js", "popup.js"],
    "maxKb": { "raw": 50 }
  },
  {
    "surface": "options JS",
    "globs": ["chunks/options-*.js", "options.js"],
    "maxKb": { "raw": 50 }
  },
  {
    "surface": "exclusion builder JS",
    "globs": ["chunks/exclusion-builder-*.js", "exclusion-builder.js"],
    "maxKb": { "raw": 50 }
  },
  {
    "surface": "isolated content script",
    "globs": ["content-scripts/isolated*.js"],
    "maxKb": { "raw": 88, "gzip": 31 }
  },
  {
    "surface": "main-world content script",
    "globs": ["content-scripts/main-world*.js"],
    "maxKb": { "raw": 8 }
  },
  {
    "surface": "devtools panel JS (all panel chunks)",
    "globs": ["chunks/panel-*.js", "panel.js", "chunks/fdt-*.js"],
    "maxKb": { "raw": 600 }
