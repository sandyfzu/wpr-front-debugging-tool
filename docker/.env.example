# Local test-site configuration for the dockerized WordPress debugging site — local and
# disposable only. The values are intentionally static so every boot is identical; they
# are deliberately non-secret but still stay out of git. Copy to `.env` (git-ignored):
#   cp docker/.env.example docker/.env
# docker/scripts/up.sh performs the copy automatically when `.env` is missing.
# Credentials live in this file and print nowhere: the bootstrap never echoes them.

# Host port the site is published on (loopback only). Must be free — up.sh checks.
WPR_FDT_TCP_PORT=8493

# Absolute site URL. Host and container port are identical, so this never diverges from
# the published port. Changing the port after the first boot re-runs the bootstrap and
# updates the WordPress URL automatically.
WPR_FDT_SITE_URL=http://127.0.0.1:8493

# wp-admin test credentials created by the bootstrap on first boot (or whenever the DB
# is freshly reset). Use these to log in at /wp-admin/
WPR_FDT_ADMIN_USER=fdt-admin
WPR_FDT_ADMIN_PASSWORD=fdt-local-admin
WPR_FDT_ADMIN_EMAIL=fdt-admin@example.test

# WP Rocket build pin. The zip at docker/wpr/wpr-rocket.zip is produced by
#   apvm build wp-rocket tag:latest-stable <output-dir>
# (built here at tag v3.24.1 @ 4d37b19 → version 3.24.1); the bootstrap fails boot
# if the installed version does not match this value, so a stale zip cannot slip in.
WPR_FDT_EXPECTED_WPR_VERSION=3.24.1

# Database credentials (MariaDB 11.8). Static local-only values; used by both services.
MYSQL_ROOT_PASSWORD=fdt-local-root
MYSQL_DATABASE=fdt_wordpress
MYSQL_USER=fdt_db_user
MYSQL_PASSWORD=fdt-local-db
