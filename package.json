{
  "name": "wpr-front-debugging-tool",
  "description": "A tool for debugging WP Rocket WordPress plugin.",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "author": {
    "name": "Sandy Figueroa",
    "url": "https://github.com/sandyfzu/"
  },
  "license": "UNLICENSED",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && node scripts/build-stamp.ts",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "bench:detection": "vitest run --config lib/detection/bench/vitest.bench.config.ts --silent=false",
    "check:budgets": "node scripts/check-budgets.mjs",
    "parity:wp-rocket": "node scripts/wp-rocket-parity.ts",
    "postinstall": "wxt prepare",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,html,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@12.9.1",
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "@tanstack/solid-virtual": "^3.13.47",
    "@webext-core/messaging": "^4.0.0",
    "clsx": "^2.1.1",
    "jsonrepair": "^3.15.0",
    "lucide-solid": "^1.57.0",
    "shiki": "^4.5.0",
    "solid-js": "^1.9.17",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.64.1",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.5",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.0.3",
    "@wxt-dev/module-solid": "^1.1.4",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-solid": "^0.18.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "5.0.3",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  }
}
