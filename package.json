{
  "name": "wpr-front-debugging-tool",
  "description": "A tool for debugging WP Rocket WordPress plugin.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "author": {
    "name": "Sandy Figueroa",
    "url": "https://github.com/sandyfzu/"
  },
  "license": "UNLICENSED",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "wxt prepare",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,html,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@12.9.1",
  "dependencies": {
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@wxt-dev/module-solid": "^1.1.4",
    "eslint": "^10.12.0",
    "eslint-plugin-solid": "^0.17.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  }
}
