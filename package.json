{
  "name": "wpr-front-debugging-tool",
  "description": "See how WP Rocket optimizes any page, inspect scripts and styles, and test exclusions, Remove Unused CSS and the beacon live.",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "author": {
    "name": "Sandy Figueroa",
    "url": "https://github.com/sandyfzu/"
  },
  "license": "UNLICENSED",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && node scripts/build-stamp.ts",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:firefox": "web-ext lint -s .output/firefox-mv2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:shard": "vitest run --coverage --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0 --coverage.reporter=text-summary --reporter=default --reporter=blob",
    "test:merge": "vitest run --merge-reports --coverage",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "bench:detection": "vitest run --config lib/detection/bench/vitest.bench.config.ts --silent=false",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check:html": "node scripts/check-html-refs.mjs",
    "screenshots": "node scripts/panel-screenshots.mjs",
    "parity:wp-rocket": "node scripts/wp-rocket-parity.ts",
    "icons": "node scripts/generate-icons.mjs",
    "store:assets": "node scripts/generate-store-assets.mjs",
    "postinstall": "wxt prepare",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,html,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@12.9.1",
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "@tanstack/solid-virtual": "^3.13.54",
    "@webext-core/messaging": "^4.0.2",
    "clsx": "^2.1.1",
    "lucide-solid": "^1.77.0",
    "shiki": "^4.6.0",
    "solid-js": "^1.9.20",
    "tailwind-merge": "^3.7.1",
    "wp-rocket-scripts": "1.2.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.1",
    "@resvg/resvg-js": "2.6.2",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.0.3",
    "@wxt-dev/module-solid": "^1.1.4",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "eslint-plugin-solid": "^0.18.1",
    "globals": "^17.14.0",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.17",
    "vitest": "5.0.3",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
